<table width="100%" cellspacing="0" cellpadding="0" border="0">
    <tr>
        <td align="left">
            <input title="Save" 
                   class="button" 
                   type="submit" 
                   name="button" 
                   value="Save"
                   onclick="this.form.action.value='Save';">
            
            <input title="Cancel" 
                   class="button" 
                   type="button" 
                   name="cancel" 
                   value="Cancel"
                   onclick="window.history.back();">
        </td>
    </tr>
</table>